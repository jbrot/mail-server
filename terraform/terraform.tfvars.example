# Terraform variables for email server
#
# NOTE: All values are auto-generated from your Nix config by deploy.sh.
# This file is for reference only - do not create a terraform.tfvars manually.
#
# To configure your deployment, edit your config file:
#   config/<name>/mail-server.nix
#
# Then run:
#   ./scripts/deploy.sh -c <name>
#
# Example values (from Nix config):

aws_region       = "us-east-1"       # aws.region
instance_type    = "t3.small"        # aws.instanceType
data_volume_size = 50                # aws.dataVolumeSize
key_name         = "your-ssh-key"    # aws.keyName
architecture     = "x86_64-linux"    # architecture (passed through from Nix)
