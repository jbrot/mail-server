# Standalone Dovecot container service module
# nix/nixos/dovecot.nix

{ config, lib, pkgs, ... }:

let
  cfg = config.services.dovecotContainer;

  # Generate passwd-file for virtual users (user:password:uid:gid:gecos:home:shell)
  # The scheme is specified in passdb args, so we don't prefix the hash here
  # Users are simple usernames (e.g., "alice"), not full email addresses
  passwdFile = pkgs.writeText "passwd" (
    lib.concatStringsSep "\n" (
      lib.mapAttrsToList (user: hash: "${user}:${hash}:5000:5000::/data/mail/${user}:") cfg.users
    ) + "\n"
  );

  # Sieve script for learning spam (when mail is moved to Junk)
  reportSpamSieve = pkgs.writeText "report-spam.sieve" ''
    require ["vnd.dovecot.pipe", "copy", "imapsieve", "environment", "variables"];

    if environment :matches "imap.user" "*" {
      set "username" "${"\${1}"}";
    }

    pipe :copy "sa-learn-spam.sh" [ "${"\${username}"}" ];
  '';

  # Sieve script for learning ham (when mail is moved out of Junk)
  reportHamSieve = pkgs.writeText "report-ham.sieve" ''
    require ["vnd.dovecot.pipe", "copy", "imapsieve", "environment", "variables"];

    if environment :matches "imap.mailbox" "*" {
      set "mailbox" "${"\${1}"}";
    }

    if string "${"\${mailbox}"}" "Trash" {
      stop;
    }

    if environment :matches "imap.user" "*" {
      set "username" "${"\${1}"}";
    }

    pipe :copy "sa-learn-ham.sh" [ "${"\${username}"}" ];
  '';

  # Shell script to learn spam via rspamc
  # Use /usr/bin/rspamc which is symlinked in the container
  saLearnSpamSh = pkgs.writeText "sa-learn-spam.sh" ''
    #!/bin/sh
    exec /usr/bin/rspamc -h ${cfg.rspamd.host} -d "$1" learn_spam
  '';

  # Shell script to learn ham via rspamc
  saLearnHamSh = pkgs.writeText "sa-learn-ham.sh" ''
    #!/bin/sh
    exec /usr/bin/rspamc -h ${cfg.rspamd.host} -d "$1" learn_ham
  '';

  # Sieve script for automatic spam filtering (LMTP delivery)
  # Checks for rspamd spam headers and files to Junk folder
  spamFilterSieve = pkgs.writeText "spam-filter.sieve" ''
    require ["fileinto", "mailbox"];

    # File spam to Junk folder based on rspamd headers
    # rspamd adds X-Spam: Yes when score >= add_header threshold
    if header :contains "X-Spam" "Yes" {
        fileinto :create "Junk";
        stop;
    }
  '';

  # Config for sieve compilation with correct module path for build environment
  sieveCompileConf = pkgs.writeText "sieve-compile.conf" ''
    mail_plugin_dir = ${pkgs.dovecot_pigeonhole}/lib/dovecot
    plugin {
      sieve_plugins = sieve_imapsieve sieve_extprograms
      sieve_extensions = +vnd.dovecot.pipe +vnd.dovecot.environment
    }
  '';

  # Helper to compile a sieve script
  # Use bwrap to create a fake root so /etc/dovecot/sieve path is embedded correctly
  compileSieve = name: source: pkgs.runCommand "${name}.svbin" {
    nativeBuildInputs = [ pkgs.dovecot_pigeonhole pkgs.bubblewrap ];
  } ''
    # Create output directory
    mkdir -p out

    # Use bwrap to create isolated root with correct paths
    bwrap \
      --ro-bind /nix/store /nix/store \
      --ro-bind /etc/passwd /etc/passwd \
      --ro-bind ${source} /etc/dovecot/sieve/${name}.sieve \
      --ro-bind ${sieveCompileConf} /sieve-compile.conf \
      --bind $PWD/out /out \
      --dev /dev \
      --proc /proc \
      ${pkgs.dovecot_pigeonhole}/bin/sievec -c /sieve-compile.conf /etc/dovecot/sieve/${name}.sieve /out/${name}.svbin

    cp out/${name}.svbin $out
  '';

  # Pre-compiled sieve binaries
  spamFilterSieveBin = compileSieve "spam-filter" spamFilterSieve;
  reportSpamSieveBin = compileSieve "report-spam" reportSpamSieve;
  reportHamSieveBin = compileSieve "report-ham" reportHamSieve;

  # Generate dovecot.conf based on options
  dovecotConf = pkgs.writeText "dovecot.conf" ''
    # Dovecot Configuration - Generated by NixOS module

    # Protocols to enable
    protocols = imap ${lib.optionalString cfg.enableLmtp "lmtp"}

    # Mail location
    mail_location = ${cfg.mailLocation}

    # Virtual mail user
    mail_uid = 5000
    mail_gid = 5000
    first_valid_uid = 5000
    last_valid_uid = 5000

    # SSL/TLS configuration
    ssl = required
    ssl_cert = <${cfg.sslCert}
    ssl_key = <${cfg.sslKey}
    ssl_min_protocol = TLSv1.2

    # Authentication
    auth_mechanisms = plain login

    # User database - passwd-file for virtual users
    passdb {
      driver = passwd-file
      args = scheme=SHA512-CRYPT /etc/dovecot/passwd
    }

    userdb {
      driver = static
      args = uid=5000 gid=5000 home=/data/mail/%u
    }

    # Maildir settings
    namespace inbox {
      inbox = yes
      separator = /

      mailbox Drafts {
        auto = subscribe
        special_use = \Drafts
      }
      mailbox Sent {
        auto = subscribe
        special_use = \Sent
      }
      mailbox Trash {
        auto = subscribe
        special_use = \Trash
      }
      mailbox Junk {
        auto = subscribe
        special_use = \Junk
      }
    }

    # Logging
    log_path = /dev/stderr
    info_log_path = /dev/stderr
    debug_log_path = /dev/stderr

    # Service configuration
    service imap-login {
      inet_listener imaps {
        port = 993
        ssl = yes
      }
      inet_listener imap {
        port = 143
      }
    }

    ${lib.optionalString cfg.enableLmtp ''
    service lmtp {
      inet_listener lmtp {
        address = 0.0.0.0
        port = ${toString cfg.lmtpPort}
      }
    }

    protocol lmtp {
      postmaster_address = postmaster@localhost
      mail_plugins = $mail_plugins sieve
    }
    ''}

    # Sieve configuration for automatic spam filtering
    plugin {
      # Run spam filter before user scripts
      sieve_before = file:/etc/dovecot/sieve/spam-filter.sieve
    }

    ${lib.optionalString cfg.rspamd.enable ''
    # IMAP Sieve for rspamd integration (spam/ham learning)
    protocol imap {
      mail_plugins = $mail_plugins imap_sieve
    }

    plugin {
      sieve_plugins = sieve_imapsieve sieve_extprograms
      sieve_global_extensions = +vnd.dovecot.pipe +vnd.dovecot.environment

      # Learn spam when mail is moved to Junk
      imapsieve_mailbox1_name = Junk
      imapsieve_mailbox1_causes = COPY APPEND
      imapsieve_mailbox1_before = file:/etc/dovecot/sieve/report-spam.sieve

      # Learn ham when mail is moved out of Junk
      imapsieve_mailbox2_name = *
      imapsieve_mailbox2_from = Junk
      imapsieve_mailbox2_causes = COPY
      imapsieve_mailbox2_before = file:/etc/dovecot/sieve/report-ham.sieve

      # Learn ham when mail is appended to Inbox (e.g., from other clients)
      imapsieve_mailbox3_name = INBOX
      imapsieve_mailbox3_causes = APPEND
      imapsieve_mailbox3_before = file:/etc/dovecot/sieve/report-ham.sieve

      # Directory for pipe scripts
      sieve_pipe_bin_dir = /etc/dovecot/sieve
    }
    ''}
  '';

in
{
  options.services.dovecotContainer = {
    enable = lib.mkEnableOption "Dovecot container";

    image = lib.mkOption {
      type = lib.types.str;
      description = "Container image URI";
    };

    mailLocation = lib.mkOption {
      type = lib.types.str;
      default = "maildir:/data/mail/%u";
      description = "Mail storage location (Dovecot mail_location format)";
    };

    sslCert = lib.mkOption {
      type = lib.types.str;
      default = "/data/certs/fullchain.pem";
      description = "Path to SSL certificate file";
    };

    sslKey = lib.mkOption {
      type = lib.types.str;
      default = "/data/certs/key.pem";
      description = "Path to SSL private key file";
    };

    users = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      example = { "alice" = "$6$..."; };
      description = "Virtual mail users (username = SHA512-CRYPT password hash)";
    };

    enableLmtp = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable LMTP for mail delivery from MTA";
    };

    lmtpPort = lib.mkOption {
      type = lib.types.int;
      default = 24;
      description = "Port for LMTP service";
    };

    rspamd = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Enable rspamd integration for spam/ham learning via IMAP actions";
      };

      host = lib.mkOption {
        type = lib.types.str;
        default = "127.0.0.1:11334";
        description = "Rspamd controller host:port for rspamc learn commands";
      };
    };

  };

  config = lib.mkIf cfg.enable {
    # Dovecot container
    virtualisation.oci-containers.containers.dovecot = {
      image = cfg.image;
      autoStart = true;

      # Use host network
      extraOptions = [
        "--network=host"
        "--cap-add=NET_BIND_SERVICE"
        "--cap-add=SETUID"
        "--cap-add=SETGID"
        "--cap-add=CHOWN"
      ];

      # Volume mounts - mount individual config files to preserve container's modules
      volumes = [
        "/data/mail:/data/mail"
        "/data/certs:/data/certs:ro"
        "/etc/dovecot/dovecot.conf:/etc/dovecot/dovecot.conf:ro"
        "/etc/dovecot/passwd:/etc/dovecot/passwd:ro"
        "/etc/dovecot/sieve:/etc/dovecot/sieve:ro"
      ];

      # Environment
      environment = {
        TZ = "UTC";
      };
    };

    # Container service configuration
    systemd.services.podman-dovecot = {
      after = [ "network-online.target" ];
      serviceConfig = {
        Restart = "always";
        RestartSec = "10s";
      };
    };

    # Create configuration directories
    systemd.tmpfiles.rules = [
      "d /etc/dovecot 0755 root root -"
      "d /etc/dovecot/sieve 0755 root root -"
      "d /data/mail 0700 5000 5000 -"
      "d /data/sieve 0700 5000 5000 -"
    ];

    # Deploy configuration files
    environment.etc = {
      "dovecot/dovecot.conf" = {
        source = dovecotConf;
        mode = "0644";
      };

      "dovecot/passwd" = {
        source = passwdFile;
        mode = "0644";
      };

      # Spam filter sieve script (files X-Spam: Yes to Junk)
      "dovecot/sieve/spam-filter.sieve" = {
        source = spamFilterSieve;
        mode = "0644";
      };
      "dovecot/sieve/spam-filter.svbin" = {
        source = spamFilterSieveBin;
        mode = "0644";
      };
    } // lib.optionalAttrs cfg.rspamd.enable {
      "dovecot/sieve/report-spam.sieve" = {
        source = reportSpamSieve;
        mode = "0644";
      };
      "dovecot/sieve/report-spam.svbin" = {
        source = reportSpamSieveBin;
        mode = "0644";
      };

      "dovecot/sieve/report-ham.sieve" = {
        source = reportHamSieve;
        mode = "0644";
      };
      "dovecot/sieve/report-ham.svbin" = {
        source = reportHamSieveBin;
        mode = "0644";
      };

      "dovecot/sieve/sa-learn-spam.sh" = {
        source = saLearnSpamSh;
        mode = "0755";
      };

      "dovecot/sieve/sa-learn-ham.sh" = {
        source = saLearnHamSh;
        mode = "0755";
      };
    };
  };
}
