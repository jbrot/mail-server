# Standalone Dovecot container service module
# nix/nixos/dovecot.nix

{ config, lib, pkgs, ... }:

let
  cfg = config.services.dovecotContainer;

  # Generate passwd-file for virtual users (user:password:uid:gid:gecos:home:shell)
  # The scheme is specified in passdb args, so we don't prefix the hash here
  passwdFile = pkgs.writeText "passwd" (
    lib.concatStringsSep "\n" (
      lib.mapAttrsToList (user: hash: "${user}:${hash}:5000:5000::/data/mail/${lib.head (lib.splitString "@" user)}:") cfg.users
    ) + "\n"
  );

  # Generate dovecot.conf based on options
  dovecotConf = pkgs.writeText "dovecot.conf" ''
    # Dovecot Configuration - Generated by NixOS module

    # Protocols to enable
    protocols = imap ${lib.optionalString cfg.enableLmtp "lmtp"} ${lib.optionalString cfg.enableSieve "sieve"}

    # Mail location
    mail_location = ${cfg.mailLocation}

    # Virtual mail user
    mail_uid = 5000
    mail_gid = 5000
    first_valid_uid = 5000
    last_valid_uid = 5000

    # SSL/TLS configuration
    ssl = required
    ssl_cert = <${cfg.sslCert}
    ssl_key = <${cfg.sslKey}
    ssl_min_protocol = TLSv1.2

    # Authentication
    auth_mechanisms = plain login

    # User database - passwd-file for virtual users
    passdb {
      driver = passwd-file
      args = scheme=SHA512-CRYPT /etc/dovecot/passwd
    }

    userdb {
      driver = static
      args = uid=5000 gid=5000 home=/data/mail/%d/%n
    }

    # Maildir settings
    namespace inbox {
      inbox = yes
      separator = /

      mailbox Drafts {
        auto = subscribe
        special_use = \Drafts
      }
      mailbox Sent {
        auto = subscribe
        special_use = \Sent
      }
      mailbox Trash {
        auto = subscribe
        special_use = \Trash
      }
      mailbox Junk {
        auto = subscribe
        special_use = \Junk
      }
    }

    # Logging
    log_path = /dev/stderr
    info_log_path = /dev/stderr
    debug_log_path = /dev/stderr

    # Service configuration
    service imap-login {
      inet_listener imaps {
        port = 993
        ssl = yes
      }
      inet_listener imap {
        port = 143
      }
    }

    ${lib.optionalString cfg.enableLmtp ''
    service lmtp {
      inet_listener lmtp {
        address = 0.0.0.0
        port = ${toString cfg.lmtpPort}
      }
    }

    protocol lmtp {
      postmaster_address = postmaster@localhost
      ${lib.optionalString cfg.enableSieve "mail_plugins = sieve"}
    }
    ''}

    ${lib.optionalString cfg.enableSieve ''
    plugin {
      sieve = /data/sieve/%d/%n/.dovecot.sieve
      sieve_dir = /data/sieve/%d/%n/
    }
    ''}
  '';

in
{
  options.services.dovecotContainer = {
    enable = lib.mkEnableOption "Dovecot container";

    image = lib.mkOption {
      type = lib.types.str;
      description = "Container image URI";
    };

    mailLocation = lib.mkOption {
      type = lib.types.str;
      default = "maildir:/data/mail/%d/%n";
      description = "Mail storage location (Dovecot mail_location format)";
    };

    sslCert = lib.mkOption {
      type = lib.types.str;
      default = "/data/certs/fullchain.pem";
      description = "Path to SSL certificate file";
    };

    sslKey = lib.mkOption {
      type = lib.types.str;
      default = "/data/certs/key.pem";
      description = "Path to SSL private key file";
    };

    users = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      example = { "user@example.com" = "$6$..."; };
      description = "Virtual mail users (user@domain = SHA512-CRYPT password hash)";
    };

    enableLmtp = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable LMTP for mail delivery from MTA";
    };

    lmtpPort = lib.mkOption {
      type = lib.types.int;
      default = 24;
      description = "Port for LMTP service";
    };

    enableSieve = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable Sieve mail filtering";
    };
  };

  config = lib.mkIf cfg.enable {
    # Dovecot container
    virtualisation.oci-containers.containers.dovecot = {
      image = cfg.image;
      autoStart = true;

      # Use host network
      extraOptions = [
        "--network=host"
        "--cap-add=NET_BIND_SERVICE"
        "--cap-add=SETUID"
        "--cap-add=SETGID"
        "--cap-add=CHOWN"
      ];

      # Volume mounts - mount individual config files to preserve container's modules
      volumes = [
        "/data/mail:/data/mail"
        "/data/certs:/data/certs:ro"
        "/etc/dovecot/dovecot.conf:/etc/dovecot/dovecot.conf:ro"
        "/etc/dovecot/passwd:/etc/dovecot/passwd:ro"
      ];

      # Environment
      environment = {
        TZ = "UTC";
      };
    };

    # Container service configuration
    systemd.services.podman-dovecot = {
      after = [ "network-online.target" ];
      serviceConfig = {
        Restart = "always";
        RestartSec = "10s";
      };
    };

    # Create configuration directories
    systemd.tmpfiles.rules = [
      "d /etc/dovecot 0755 root root -"
      "d /data/mail 0700 5000 5000 -"
      "d /data/sieve 0700 5000 5000 -"
    ];

    # Deploy configuration files
    environment.etc = {
      "dovecot/dovecot.conf" = {
        source = dovecotConf;
        mode = "0644";
      };

      "dovecot/passwd" = {
        source = passwdFile;
        mode = "0644";
      };
    };
  };
}
