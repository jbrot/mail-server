# Standalone OpenSMTPd container service module
# nix/nixos/opensmtpd.nix

{ config, lib, pkgs, ... }:

let
  cfg = config.services.opensmtpdContainer;

  # Generate smtpd.conf based on options
  smtpdConf = pkgs.writeText "smtpd.conf" ''
    # OpenSMTPd Configuration - Generated by NixOS module

    # PKI certificates
    pki ${cfg.domain} cert "/data/certs/fullchain.pem"
    pki ${cfg.domain} key "/data/certs/key.pem"

    # Tables for virtual domains and users
    table aliases file:/etc/smtpd/aliases
    table domains file:/etc/smtpd/domains
    ${if cfg.localDelivery then "" else "table virtuals file:/etc/smtpd/virtuals"}

    # Filters
    ${lib.optionalString cfg.enableRspamd ''
    filter rspamd proc-exec "filter-rspamd"
    ''}

    # Listen on all interfaces
    # Port 25 - SMTP (for receiving mail from other servers)
    listen on 0.0.0.0 port 25 tls pki ${cfg.domain}${lib.optionalString cfg.enableRspamd " filter rspamd"}

    # Port 587 - Submission (STARTTLS, for client submission)
    listen on 0.0.0.0 port 587 tls-require pki ${cfg.domain} auth${lib.optionalString cfg.enableRspamd " filter rspamd"}

    # Actions
    ${if cfg.localDelivery then ''
    action "local_mail" mbox
    '' else ''
    action "local_mail" lmtp localhost:24 virtual <virtuals>
    ''}
    action "outbound" relay

    # Matching rules
    # Accept mail for our domains
    match from any for domain <domains> action "local_mail"

    # Allow authenticated users to send mail
    match from any auth for any action "outbound"

    # Reject everything else is implicit
  '';

in
{
  options.services.opensmtpdContainer = {
    enable = lib.mkEnableOption "OpenSMTPd container";

    image = lib.mkOption {
      type = lib.types.str;
      description = "Container image URI";
    };

    domain = lib.mkOption {
      type = lib.types.str;
      example = "mail.example.com";
      description = "Primary mail domain (used for PKI)";
    };

    localDelivery = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Use local mbox delivery instead of LMTP";
    };

    enableRspamd = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable rspamd filter";
    };

    domains = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      example = [ "example.com" "mail.example.com" ];
      description = "List of domains to accept mail for";
    };

    aliases = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {
        postmaster = "root";
        abuse = "root";
      };
      description = "Mail aliases";
    };

    virtuals = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      example = { "@example.com" = "vmail"; };
      description = "Virtual user mappings for LMTP delivery";
    };
  };

  config = lib.mkIf cfg.enable {
    # OpenSMTPd container
    virtualisation.oci-containers.containers.opensmtpd = {
      image = cfg.image;
      autoStart = true;

      # Use host network
      extraOptions = [
        "--network=host"
        "--cap-add=NET_BIND_SERVICE"
        "--cap-add=SETUID"
        "--cap-add=SETGID"
      ];

      # Volume mounts
      volumes = [
        "/data/mail:/var/mail"
        "/data/certs:/data/certs:ro"
        "/etc/smtpd:/etc/smtpd:ro"
      ];

      # Environment
      environment = {
        TZ = "UTC";
      };

      # Dependencies
      dependsOn = lib.optionals cfg.enableRspamd [ "rspamd" ];
    };

    # Container service configuration
    systemd.services.podman-opensmtpd = {
      after = [ "network-online.target" ];
      serviceConfig = {
        Restart = "always";
        RestartSec = "10s";
      };
    };

    # Create configuration directories
    systemd.tmpfiles.rules = [
      "d /etc/smtpd 0755 root root -"
      "d /data/mail 1777 root root -"
    ];

    # Deploy configuration files
    environment.etc = {
      "smtpd/smtpd.conf" = {
        source = smtpdConf;
        mode = "0644";
      };

      "smtpd/aliases" = {
        text = lib.concatStringsSep "\n" (
          lib.mapAttrsToList (name: target: "${name}: ${target}") cfg.aliases
        ) + "\n";
        mode = "0644";
      };

      "smtpd/domains" = {
        text = lib.concatStringsSep "\n" cfg.domains + "\n";
        mode = "0644";
      };
    } // lib.optionalAttrs (!cfg.localDelivery) {
      "smtpd/virtuals" = {
        text = lib.concatStringsSep "\n" (
          lib.mapAttrsToList (pattern: target: "${pattern}    ${target}") cfg.virtuals
        ) + "\n";
        mode = "0644";
      };
    };
  };
}
