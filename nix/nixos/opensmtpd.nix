# Standalone OpenSMTPd container service module
# nix/nixos/opensmtpd.nix

{ config, lib, pkgs, ... }:

let
  cfg = config.services.opensmtpdContainer;

  # Get list of usernames from credentials
  usernames = lib.attrNames cfg.credentials;

  # Generate smtpd.conf based on options
  smtpdConf = pkgs.writeText "smtpd.conf" ''
    # OpenSMTPd Configuration - Generated by NixOS module

    # PKI certificates
    pki ${cfg.serverDomain} cert "/data/certs/fullchain.pem"
    pki ${cfg.serverDomain} key "/data/certs/key.pem"

    # Tables
    table virtuals file:/etc/smtpd/virtuals
    ${lib.optionalString (cfg.credentials != {}) "table credentials file:/etc/smtpd/credentials"}
    ${lib.optionalString (cfg.credentials != {}) "table users file:/etc/smtpd/userbase"}

    # Filters
    ${lib.optionalString cfg.enableDnsFilters ''
    filter check_dyndns phase connect match rdns regex { '.*\.dyn\..*', '.*\.dsl\..*' } \
        disconnect "550 no residential connections"

    filter check_rdns phase connect match !rdns \
        disconnect "550 no rDNS is so 80s"

    filter check_fcrdns phase connect match !fcrdns \
        disconnect "550 no FCrDNS is so 80s"
    ''}
    ${lib.optionalString cfg.enableRspamd ''
    filter rspamd proc-exec "${pkgs.opensmtpd-filter-rspamd}/bin/filter-rspamd -url http://${cfg.rspamdHost}:11333"
    ''}

    # Listen on all interfaces
    # Port 25 - SMTP (for receiving mail from other servers)
    ${let
      dnsFilters = lib.optionalString cfg.enableDnsFilters "check_dyndns, check_rdns, check_fcrdns";
      rspamdFilter = lib.optionalString cfg.enableRspamd "rspamd";
      allFilters = lib.filter (s: s != "") [ dnsFilters rspamdFilter ];
      filterClause = if allFilters == [] then "" else " filter { ${lib.concatStringsSep ", " allFilters} }";
    in "listen on 0.0.0.0 port 25 tls pki ${cfg.serverDomain}${filterClause}"}

    # Port 587 - Submission (STARTTLS, for client submission)
    listen on 0.0.0.0 port 587 tls-require pki ${cfg.serverDomain} auth ${lib.optionalString (cfg.credentials != {}) "<credentials>"}${lib.optionalString cfg.enableRspamd " filter rspamd"}

    ${lib.optionalString (cfg.localSubmissionPort != null) ''
    # Port ${toString cfg.localSubmissionPort} - Local submission (no TLS, no auth, no filters)
    # For system-generated mail (e.g., Monit alerts) that should bypass spam filtering
    listen on 0.0.0.0 port ${toString cfg.localSubmissionPort}
    ''}

    # Actions
    ${if cfg.localDelivery then ''
    action "local_mail" maildir "/data/mail/%{dest.user}" junk userbase <users> virtual <virtuals>
    '' else ''
    action "local_mail" lmtp ${cfg.lmtpHost}:${toString cfg.lmtpPort} userbase <users> virtual <virtuals>
    ''}
    action "outbound" relay helo ${cfg.serverDomain}

    # Matching rules
    # Accept mail for domain ${cfg.emailDomain}
    match from any for domain "${cfg.emailDomain}" action "local_mail"

    # Allow authenticated users to send mail anywhere
    match from any auth for any action "outbound"

    # Reject everything else is implicit
  '';

in
{
  options.services.opensmtpdContainer = {
    enable = lib.mkEnableOption "OpenSMTPd container";

    image = lib.mkOption {
      type = lib.types.str;
      description = "Container image URI";
    };

    serverDomain = lib.mkOption {
      type = lib.types.str;
      example = "mail.example.com";
      description = "Mail server hostname (used for PKI and HELO)";
    };

    emailDomain = lib.mkOption {
      type = lib.types.str;
      example = "example.com";
      description = "Email domain for user addresses (user@example.com)";
    };

    localDelivery = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Use local maildir delivery instead of LMTP to Dovecot";
    };

    lmtpPort = lib.mkOption {
      type = lib.types.int;
      default = 24;
      description = "Port for LMTP delivery to Dovecot";
    };

    enableRspamd = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Enable rspamd filter";
    };

    enableDnsFilters = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable DNS-based filters (rDNS, FCrDNS, dyndns check). Disable for container/test environments without proper DNS.";
    };

    aliases = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      example = { "postmaster" = "admin"; };
      description = "Additional mail aliases (name -> target username)";
    };

    credentials = lib.mkOption {
      type = lib.types.attrsOf lib.types.str;
      default = {};
      example = { "alice" = "$6$..."; "bob" = "$6$..."; };
      description = "User credentials (username = password hash). Domain is added automatically.";
    };

    mailUid = lib.mkOption {
      type = lib.types.int;
      default = 5000;
      description = "UID for virtual mail user";
    };

    mailGid = lib.mkOption {
      type = lib.types.int;
      default = 5000;
      description = "GID for virtual mail group";
    };

    # Network configuration
    networking = {
      networks = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [];
        description = "List of podman networks to attach";
      };

      publishPorts = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ "25:25" "587:587" ];
        description = "Ports to publish to host";
      };
    };

    rspamdHost = lib.mkOption {
      type = lib.types.str;
      default = "rspamd";
      description = "Hostname for rspamd milter connection (container name on shared network)";
    };

    lmtpHost = lib.mkOption {
      type = lib.types.str;
      default = "dovecot";
      description = "Hostname for LMTP delivery to Dovecot (container name on shared network)";
    };

    localSubmissionPort = lib.mkOption {
      type = lib.types.nullOr lib.types.int;
      default = null;
      example = 10025;
      description = "Port for local mail submission (no TLS, no auth, no spam filtering). Set to null to disable.";
    };

    # Resource limits
    resources = {
      memory = lib.mkOption {
        type = lib.types.int;
        default = 192;
        description = "Container memory limit in MB";
      };

      memoryReservation = lib.mkOption {
        type = lib.types.int;
        default = 128;
        description = "Container memory reservation (soft limit) in MB";
      };

      cpus = lib.mkOption {
        type = lib.types.float;
        default = 0.5;
        description = "CPU limit";
      };

      pidsLimit = lib.mkOption {
        type = lib.types.int;
        default = 100;
        description = "Maximum number of PIDs in the container";
      };
    };
  };

  config = lib.mkIf cfg.enable (let
    # Capabilities needed by the container
    # - NET_BIND_SERVICE: bind to ports < 1024 (25, 587)
    # - SETUID/SETGID: only needed for local maildir delivery (not LMTP)
    capabilities = [ "NET_BIND_SERVICE" ]
      ++ lib.optionals cfg.localDelivery [ "SETUID" "SETGID" ];
  in {
    # OpenSMTPd container
    virtualisation.oci-containers.containers.opensmtpd = {
      image = cfg.image;
      autoStart = true;

      extraOptions =
        # Network configuration
        (map (net: "--network=${net}") cfg.networking.networks)
        ++ [ "--hostname=opensmtpd" ]
        ++ (map (p: "-p=${p}") cfg.networking.publishPorts)
        # Capabilities
        ++ (map (cap: "--cap-add=${cap}") capabilities)
        ++ [
          # Resource limits
          "--memory=${toString cfg.resources.memory}m"
          "--memory-reservation=${toString cfg.resources.memoryReservation}m"
          "--cpus=${toString cfg.resources.cpus}"
          "--pids-limit=${toString cfg.resources.pidsLimit}"
        ];

      # Volume mounts
      # Note: /data/mail is only needed for local delivery, not LMTP (Dovecot handles storage)
      volumes = [
        "/data/certs:/data/certs:ro"
        "/etc/smtpd:/etc/smtpd:ro"
      ] ++ lib.optionals cfg.localDelivery [
        "/data/mail:/data/mail"
      ];

      # Environment
      environment = {
        TZ = "UTC";
      };

      # Dependencies
      dependsOn = lib.optionals cfg.enableRspamd [ "rspamd" ];
    };

    # Container service configuration
    systemd.services.podman-opensmtpd = {
      after = [ "network-online.target" ];
      restartTriggers = [ cfg.image ] ++
        # Restart when any /etc/smtpd/* config file changes
        (lib.mapAttrsToList (_: entry: entry.source)
          (lib.filterAttrs (name: _: lib.hasPrefix "smtpd/" name) config.environment.etc));
      serviceConfig = {
        Restart = "always";
        RestartSec = "10s";

        # Systemd hardening
        # Note: ProtectSystem omitted - podman needs write access to /var/lib/containers and /etc/containers
        # Note: NoNewPrivileges omitted - podman needs to write /proc/*/uid_map for user namespaces
        # Note: CapabilityBoundingSet omitted - podman needs many capabilities; container caps are managed by podman itself
        # Mount namespace isolation settings disabled - these cause systemd to create
        # separate mount namespaces for ExecStart and ExecStop, which breaks netavark's
        # ability to access the container's network namespace bind mount during cleanup
        ProtectHome = false;
        PrivateTmp = false;
        ProtectKernelTunables = false;
        ProtectKernelModules = false;
        # ProtectControlGroups omitted - podman needs to create cgroups for containers
        RestrictSUIDSGID = true;
        # Resource limits handled by container runtime, not systemd
      };
    };

    # Create configuration directories
    systemd.tmpfiles.rules = [
      "d /etc/smtpd 0755 root root -"
    ] ++ lib.optionals cfg.localDelivery [
      # Only create mail directory when using local delivery (not LMTP)
      "d /data/mail 0700 ${toString cfg.mailUid} ${toString cfg.mailGid} -"
    ];

    # Deploy configuration files
    environment.etc = {
      "smtpd/smtpd.conf" = {
        source = smtpdConf;
        mode = "0644";
      };

      "smtpd/virtuals" = {
        text = lib.concatStringsSep "\n" (
          # Identity mappings for all users (required by virtual table)
          (map (user: "${user}@${cfg.emailDomain}    ${user}") usernames)
          ++
          # Custom aliases (target includes domain so %{dest.user} resolves correctly)
          (lib.mapAttrsToList (name: target: "${name}@${cfg.emailDomain}    ${target}@${cfg.emailDomain}") cfg.aliases)
        ) + "\n";
        mode = "0644";
      };
    } // lib.optionalAttrs (cfg.credentials != {}) {
      # Credentials file for SMTP AUTH: user@domain password_hash
      "smtpd/credentials" = {
        text = lib.concatStringsSep "\n" (
          lib.mapAttrsToList (user: pass: "${user} ${pass}") cfg.credentials
        ) + "\n";
        mode = "0640";
      };

      # Userbase file for delivery: username    uid:gid:homedir
      "smtpd/userbase" = {
        text = lib.concatStringsSep "\n" (
          map (user:
            "${user}    ${toString cfg.mailUid}:${toString cfg.mailGid}:/data/mail/${user}"
          ) usernames
        ) + "\n";
        mode = "0640";
      };
    };
  });
}
